{
    "name": "geo-global",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
      "dev": "node server/index.js",
      "dev:win": "set NODE_ENV=development && node server/index.js",
      "dev:unix": "NODE_ENV=development node server/index.js",
      "build": "vite build",
      "start": "npm run build && node server/index.js",
      "start:win": "npm run build && set NODE_ENV=production && node server/index.js",
      "start:unix": "npm run build && NODE_ENV=production node server/index.js"
    },
    "dependencies": {
      "cors": "^2.8.5",
      "express": "^4.18.2",
      "three": "^0.160.0"
    },
    "devDependencies": {
      "vite": "^5.0.0"
    }
  }